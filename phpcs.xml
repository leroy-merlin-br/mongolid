<?xml version="1.0"?>
<ruleset name="Mongolid">
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="45"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>

     <!-- Ignore warnings and show progress of the run -->
    <arg value="nps"/>

     <!-- Folders that will be tracked -->
    <file>src</file>
    <file>tests</file>

    <rule ref="LeroyMerlin">
        <exclude name="Squiz.WhiteSpace.LanguageConstructSpacing"/>
    </rule>

    <rule ref="Generic.WhiteSpace.LanguageConstructSpacing"/>

    <rule ref="SlevomatCodingStandard.ControlStructures.RequireMultiLineCondition.RequiredMultiLineCondition">
        <type>warning</type>
    </rule>

    <rule ref="SlevomatCodingStandard.Functions.RequireMultiLineCall.RequiredMultiLineCall">
        <type>warning</type>
    </rule>
</ruleset>
